# === App ===
APP_NAME=Spa WhatsApp
APP_BASE_URL=https://spa.example.com
ENV=dev
BUSINESS_TZ=Europe/Madrid

# === PostgreSQL (async) — coincide con docker-compose.yml ===
# NOTA: driver asyncpg (NO sqlite). La app usa PostgreSQL exclusivamente.
DATABASE_URL=postgresql+asyncpg://spa:spa_secret@localhost:5432/spa
DB_ECHO=false

# === Twilio WhatsApp Business API ===
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Numero WhatsApp de Twilio (sandbox: whatsapp:+14155238886 | dedicado: whatsapp:+<tu-num>)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# === Auth JWT ===
# Genera uno real: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambia-esto-en-produccion-usa-openssl-rand-hex-32
JWT_ALG=HS256
JWT_EXPIRE_MIN=720

# === z.ai SDK (agente IA — clasificador de intencion + respuesta) ===
ZAI_API_KEY=your_zai_api_key
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4-flash
AI_AGENT_ENABLED=true

# === SMTP (email de respaldo de recordatorios) ===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=postmaster@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=no-reply@spa.example.com

# === Feature flags ===
# MVP: Google Calendar sync OFF. Se anade despues.
GOOGLE_SYNC_ENABLED=false
